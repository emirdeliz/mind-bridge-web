# Copy to .env.local for local development.
# Vercel: Project → Settings → Environment Variables (all server-only vars below).

# UI only — shows demo bypass buttons (server must also set AUTH_BYPASS=true)
NEXT_PUBLIC_AUTH_BYPASS=false

# Public app URL — local dev or your Vercel URL (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3001

# WhatsApp support number for "Forgot password" on login (digits only, with country code)
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=5511999999999

# Supabase Cloud (free tier) — same project as mind-bridge-be
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# mind-bridge-be API — local or hosted (Render/Railway/Fly). Vercel proxies via /api/backend/*
API_BASE_URL=http://localhost:4000

# Server-only demo auth (pair with NEXT_PUBLIC_AUTH_BYPASS for UI)
AUTH_BYPASS=false

# Must match mind-bridge-be KNOWLEDGE_MAX_FILE_BYTES (default 10485760 = 10 MB)
# KNOWLEDGE_MAX_FILE_BYTES=10485760

# Must match mind-bridge-be SPEECH_MAX_FILE_BYTES (default 5242880 = 5 MB)
# SPEECH_MAX_FILE_BYTES=5242880
