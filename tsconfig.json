{
  "compilerOptions": {
    "target": "es2015",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "ignoreDeprecations": "5.0",
    "paths": {
      "@atoms": ["src/ui/atoms"],
      "@molecules": ["src/ui/molecules"],
      "@organisms": ["src/ui/organisms"],
      "@components": ["src/ui/components"],
      "@templates": ["src/ui/templates"],
      "@theme": ["src/ui/system/theme"],
      "@i18n": ["src/ui/system/i18n"],
      "@pages": ["src/ui/pages"],
      "@stories": ["src/ui/stories"],
      "@hooks": ["src/hooks"],
      "@services": ["src/services"],
      "@helpers": ["src/helpers"],
      "@types": ["src/types"],
      "@utils": ["src/utils"],
      "@api": ["src/api"],
      "@constants": ["src/constants"],
      "@test": ["test"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "src/ui/organisms/**",
    "src/ui/atoms/AuditSkillChip/**",
    "src/ui/atoms/Chart/**",
    "src/ui/atoms/Checkbox/**",
    "src/ui/atoms/Col/**",
    "src/ui/atoms/Divider/**",
    "src/ui/atoms/Dot/**",
    "src/ui/atoms/Fade/**",
    "src/ui/atoms/FloatingElement/**",
    "src/ui/atoms/Footer/**",
    "src/ui/atoms/Hr/**",
    "src/ui/atoms/Image/**",
    "src/ui/atoms/InfiniteScroll/**",
    "src/ui/atoms/InlineCode/**",
    "src/ui/atoms/KpiTile/**",
    "src/ui/atoms/Link/**",
    "src/ui/atoms/Loading/**",
    "src/ui/atoms/Markdown/**",
    "src/ui/atoms/Overflow/**",
    "src/ui/atoms/Overlay/**",
    "src/ui/atoms/ProgressBar/**",
    "src/ui/atoms/ResizablePanels/**",
    "src/ui/atoms/Skeleton/**",
    "src/ui/atoms/StatusBadge/**",
    "src/ui/atoms/StatusPill/**",
    "src/ui/atoms/Tabs/**",
    "src/ui/molecules/Accordion/**",
    "src/ui/molecules/Calendar/**",
    "src/ui/molecules/ChartCard/**",
    "src/ui/molecules/Dropdown/**",
    "src/ui/molecules/ErrorMessage/**",
    "src/ui/molecules/InputSearch/**",
    "src/ui/molecules/LoaderComponent/**",
    "src/ui/molecules/MenuButton/**",
    "src/ui/molecules/Modal/**",
    "src/ui/molecules/ModalTemplate/**",
    "src/ui/molecules/PageBackButton/**",
    "src/ui/molecules/ProgressBar/**",
    "src/ui/molecules/ShowSkeleton/**",
    "src/ui/molecules/StepProgressBar/**",
    "src/ui/molecules/Switch/**",
    "src/ui/molecules/Table/**",
    "src/ui/molecules/Toast/**",
    "src/ui/molecules/Tooltip/**",
    "src/ui/molecules/UpcodeMetricTip/**",
    "src/ui/molecules/upcode/**"
  ]
}
