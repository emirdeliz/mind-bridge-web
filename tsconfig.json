{
  "compilerOptions": {
    "target": "es2015",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@atoms": ["./src/ui/atoms"],
      "@molecules": ["./src/ui/molecules"],
      "@organisms": ["./src/ui/organisms"],
      "@components": ["./src/ui/components"],
      "@templates": ["./src/ui/templates"],
      "@theme": ["./src/ui/system/theme"],
      "@i18n": ["./src/ui/system/i18n"],
      "@pages": ["./src/ui/pages"],
      "@stories": ["./src/ui/stories"],
      "@hooks": ["./src/hooks"],
      "@services": ["./src/services"],
      "@helpers": ["./src/helpers"],
      "@types": ["./src/types"],
      "@api": ["./src/api"],
      "@styles": ["./src/styles"],
      "@constants": ["./src/constants"],
      "@lib/*": ["./src/lib/*"],
      "@test": ["./test"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "src/ui/atoms/Chart/**",
    "src/ui/atoms/ResizablePanels/**",
    "src/ui/organisms/LinkCalendar/**",
    "src/ui/organisms/LinkCalendarForm/**",
    "src/ui/molecules/LoaderComponent/**",
    "src/ui/**/*.spec.tsx"
  ]
}
